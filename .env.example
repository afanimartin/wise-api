# Copy this file to .env for local development.
# This generic template is intentionally secret-free.
NODE_ENV=development
APP_ENV=local
PORT=8080
LOG_LEVEL=info
DATABASE_URL=replace-with-local-dev-database-url
CORS_ORIGINS=http://localhost:3000
WEBHOOK_SIGNATURE_SECRET=replace-me-local-dev
PROJECT_ID=replace-with-local-dev-gcp-project-id
DEFAULT_WALLET_CURRENCY=SSP
